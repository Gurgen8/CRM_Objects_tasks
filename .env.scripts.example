# Только для скриптов scripts/*.ts, запускаемых локально. НЕ коммитить.
# Секретный ключ (service_role / sb_secret_...) обходит RLS — во фронтенд он не попадает:
# у переменных нет префикса VITE_, и фронтенд этот файл не читает.
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx
SUPABASE_SECRET_KEY=sb_secret_xxx

# Пароли демо-пользователей (необязательно, есть значения по умолчанию)
# SEED_MANAGER_PASSWORD=
# SEED_EXECUTOR_PASSWORD=
